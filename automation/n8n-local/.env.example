# Required: used to encrypt credentials at rest
N8N_ENCRYPTION_KEY=

# Optional basic auth for the local editor UI
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# If you expose n8n via a tunnel (ngrok/cloudflared), set these to your public URL.
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# Postgres password for the local DB (matches docker-compose.yml)
N8N_DB_PASSWORD=n8n

# Logging
N8N_LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Workflow Variables (used via `$vars.*` in n8n expressions)
#
# Note: For local Docker, set these in:
# - n8n UI -> Settings -> Variables
#
# This file is still a useful checklist of what to create as n8n Variables.
# ---------------------------------------------------------------------------

# Brand / identity
BRAND_NAME=Jeffery Addae
BRAND_FROM_NAME=Jeffery Addae
BRAND_WEBSITE=https://www.jefferyaddae.it.com
BRAND_ACCENT_COLOR=#2563eb
BRAND_ADDRESS=
BRAND_LOGO_URL=

# Where CTAs should point
BOOKING_LINK=https://www.jefferyaddae.it.com/contact

# Notifications
OWNER_EMAIL=owner@example.com
SLACK_CHANNEL_ID=C01234567

# Notion DB URLs (optional; OUTREACH_* used for outbound)
NOTION_DATABASE_URL=
LEADS_NOTION_DB_URL=
LEADS_NOTION_DEADLETTER_DB_URL=
OUTREACH_NOTION_DB_URL=

# Firebase mirror (optional for inbound lead capture)
FIREBASE_PROJECT_ID=jeffery-addae-automation
FIREBASE_WEB_API_KEY=

# Outreach integrations
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# Outreach compliance
# Point this at the production n8n webhook URL for `08-unsubscribe-suppression-handler.json`
UNSUBSCRIBE_URL_BASE=https://your-n8n.app/webhook/unsubscribe-v1
OUTREACH_DOMAIN_BLOCKLIST=
MIN_HUNTER_CONFIDENCE=70

# Hunter outreach settings
OUTREACH_CAMPAIGN_NAME=Q1 Pipeline Build
HUNTER_TARGET_DOMAINS=example.com,example.org
HUNTER_BATCH_LIMIT=25
HUNTER_FOLLOWUP_DAYS=5

# Canada outreach settings
CANADA_OUTREACH_CAMPAIGN_NAME=Canada Service Prospecting
CANADA_PLACES_QUERIES=plumber Toronto, ON; electrician Calgary, AB; dentist Vancouver, BC
CANADA_PLACES_LIMIT=8
CANADA_BATCH_LIMIT=20
CANADA_FOLLOWUP_DAYS=4
